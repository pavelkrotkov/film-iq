+def asserted_public_matches(films):
+    """Confirm supplied Wikidata/IMDb/TMDB assertions independently of artwork."""
+    asserted = {}
+    for film in films:
+        qid = str(film.get("wikidata_id") or "").rstrip("/").rsplit("/", 1)[-1]
+        imdb = film.get("imdb_id") or ""
+        if re.fullmatch(r"Q[1-9]\d*", qid) and re.fullmatch(r"tt\d{7,15}", imdb):
+            asserted[film["tmdb_id"]] = (qid, imdb)
+    if not asserted:
+        return {}
+    # Source-specific QIDs bind the identity, so a same-title remake cannot match.
+    values = " ".join("wd:" + qid for qid, _ in sorted(set(asserted.values())))
+    query = "SELECT ?item ?tmdb ?imdb WHERE { VALUES ?item { " + values + " } "
+    query += "?item wdt:P4947 ?tmdb ; wdt:P345 ?imdb . }"
+    request = Request(
+        WIKIDATA,
+        data=urlencode({"query": query, "format": "json"}).encode(),
+        headers={"User-Agent": USER_AGENT, "Accept": "application/sparql-results+json"},
+    )
+    options = defaultdict(set)
+    with urlopen(request, timeout=65) as response:
+        rows = json.load(response)["results"]["bindings"]
+    for row in rows:
+        qid = row["item"]["value"].rsplit("/", 1)[-1]
+        options[qid].add((row["tmdb"]["value"], row["imdb"]["value"]))
+    return {
+        ident: (imdb, None)
+        for ident, (qid, imdb) in asserted.items()
+        if options[qid] == {(str(ident), imdb)}
+    }

 
